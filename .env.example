# ============================================================================
# managemyteam.io — Railway-native build: environment variables
#
# Two Railway services share this repo: the WEB service (root Dockerfile)
# and the WORKER service (root directory worker/, start command
# `node index.mjs`). Copy the blocks each service needs into its Variables tab
# in Railway. Local one-off scripts (scripts/) read from your shell env.
# ============================================================================  

# ----------------------------------------------------------------------------
# DATABASE_URL — web service only (also used by local dev).
# The app_user (NON-owner) connection string: the web app connects as the
# non-owner role app_user so RLS applies. The Railway Postgres plugin gives
# you the OWNER url as DATABASE_URL. Build the app_user URL from it:
#   postgres://app_user:<APP_DB_PASSWORD>@<host>:<port>/railway
# i.e. take the plugin's DATABASE_URL and replace "postgres:<owner-pw>@"
# with "app_user:<APP_DB_PASSWORD>@". scripts/migrate.mjs creates the
# app_user role and prints nothing secret, but it accepts APP_DB_PASSWORD
# and applies it to the role, so the two stay in sync.
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://app_user:CHOOSE_A_PASSWORD@postgres.railway.internal:5432/railway

# ----------------------------------------------------------------------------
# DATABASE_OWNER_URL — web service, worker service, local scripts.
# The database OWNER connection string (the value the Railway Postgres
# plugin ships as DATABASE_URL, connecting as postgres). Bypasses RLS.
# Needed by: migration runner, seed script, web signup flow (owner pool),
# worker service, and getActiveCount. On Railway, reference the plugin's
# DATABASE_URL variable directly: ${{Postgres.DATABASE_URL}}
# (adjust "Postgres" to your plugin's name).
# ----------------------------------------------------------------------------
DATABASE_OWNER_URL=${{Postgres.DATABASE_URL}}

# ----------------------------------------------------------------------------
# APP_DB_PASSWORD — local only (never a Railway service var).
# Password for the app_user role. Generate one and pass it to the migration
# runner; migrate.mjs creates (or updates) app_user with this password.
#   openssl rand -base64 24
# ----------------------------------------------------------------------------
APP_DB_PASSWORD=

# ----------------------------------------------------------------------------
# AUTH_SECRET — web service only. Auth.js v5 signing/encryption secret.
#   openssl rand -hex 32
# ----------------------------------------------------------------------------
AUTH_SECRET=

# ----------------------------------------------------------------------------
# AUTH_URL — web service only. Public base URL of the app (set automatically
# by Railway as RAILWAY_PUBLIC_DOMAIN; set explicitly in production).
# ----------------------------------------------------------------------------
AUTH_URL=https://your-app.up.railway.app

# ----------------------------------------------------------------------------
# PHOTOS_DIR — web service only. Filesystem directory where task photos are
# stored; the app defaults to /data/photos. On Railway, attach a volume and
# mount it at /data/photos (web service -> Volumes -> Mount path:
# /data/photos) so photos survive redeploys.
# ----------------------------------------------------------------------------
PHOTOS_DIR=/data/photos

# ----------------------------------------------------------------------------
# STRIPE_SECRET_KEY — web service only. Stripe TEST mode secret key
# (starts with sk_test_...). Used for Checkout, Customer Portal, and billing.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_

# ----------------------------------------------------------------------------
# STRIPE_WEBHOOK_SECRET — web service only. From `stripe listen` (local) or
# the webhook endpoint you create in the Stripe dashboard (production,
# whsec_...). Used to verify the /api/stripe/webhook signature.
# ----------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_

# ----------------------------------------------------------------------------
# STRIPE_PRICE_ID — web service only. OPTIONAL. $1/active-employee/month
# price id (price_...). Leave blank: the app's ensurePrice() creates the
# product+price on demand and caches the id. Set it if you want a fixed,
# pre-created price instead.
# ----------------------------------------------------------------------------
STRIPE_PRICE_ID=

# ----------------------------------------------------------------------------
# RESEND_API_KEY — web service + worker service. Resend API key for report
# emails, shift-log digest emails, and trial-expiry notices. Optional: the
# app logs a skip line instead of sending when unset.
# ----------------------------------------------------------------------------
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY — web service only. Anthropic API key for the LLM shift
# digest summary (POST /api/shift-digest). Optional: digest entries are
# stored and viewable without the key; only the AI summary is skipped.
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# ANTHROPIC_MODEL — web service only. OPTIONAL. Model for the digest summary.
# ----------------------------------------------------------------------------
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----------------------------------------------------------------------------
# CRON_SECRET — web service + worker service. Shared secret the worker sends
# as a Bearer <redacted> on /api/shift-digest and /api/reports/email so only the
# worker can trigger them.
#   openssl rand -hex 32
# ----------------------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------------------
# APP_URL — worker service only. Public base URL of the WEB app
# (e.g. https://your-app.up.railway.app). The worker calls the app's API
# routes at this URL.
# ----------------------------------------------------------------------------
APP_URL=https://your-app.up.railway.app
